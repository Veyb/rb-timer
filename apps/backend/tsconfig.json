{
  "extends": "@rb-timer/typescript-config/strapi-server.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    // Strapi's own preset ships `lib: ["ES2020"]`; bumped to ES2022 (a strict
    // superset) so `Object.hasOwn` - a real Node 20+ runtime feature (matches
    // this app's own `engines` requirement) that Biome's noPrototypeBuiltins
    // rule recommends over `Object.prototype.hasOwnProperty.call` - type-checks.
    // Only the ambient lib declarations change here, not `target`/`module`.
    "lib": ["ES2022"]
  },
  "include": ["./", "src/**/*.json"],
  "exclude": [
    "node_modules/",
    "build/",
    "dist/",
    "dist-test/",
    ".cache/",
    ".tmp/",
    "src/admin/",
    "src/plugins/**"
  ]
  // `**/*.test.ts` used to be excluded here (it comes from Strapi's template).
  // Dropping it means `check-types` covers the suite: with it in place, the
  // helpers under `tests/helpers/` were checked while the tests using them
  // were not, so an editor would flag a type error that `pnpm check-types`
  // reported clean.
}
