{
  "kind": "collectionType",
  "collectionName": "bosses",
  "info": {
    "singularName": "boss",
    "pluralName": "bosses",
    "displayName": "Boss",
    "description": "DEPRECATED. Despite the name this is not a catalogue but the live respawn timer: `updateBossTime()` writes `time` and `restarted` here on every kill. The catalogue is `Raid boss`. The two are unrelated in the data — these 34 rows carry Russian names with no reliable join to the catalogue's 153 English ones — so merging them is a later change that maps them by hand. Nothing here has been altered; do not add catalogue fields to it."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "quality": {
      "type": "enumeration",
      "enum": ["none", "blue", "red", "purple"],
      "required": true,
      "default": "blue"
    },
    "interval": {
      "type": "integer",
      "min": 1,
      "required": true
    },
    "world": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "chance": {
      "type": "integer",
      "required": true,
      "max": 100,
      "min": 1
    },
    "time": {
      "type": "datetime",
      "required": true,
      "default": "2022-01-31T21:00:00.000Z"
    },
    "approximately": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "alliance": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "restarted": {
      "type": "boolean",
      "default": false
    },
    "firstInterval": {
      "type": "integer",
      "min": 0
    }
  }
}
