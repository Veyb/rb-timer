{
  "kind": "collectionType",
  "collectionName": "items",
  "info": {
    "singularName": "item",
    "pluralName": "items",
    "displayName": "Item",
    "description": "Something a raid boss drops. Identity is the name: the source's `itemId` names the icon, not the item, and 737 distinct items share 359 icons \u2014 keying on it would collapse the catalogue to less than half."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "config": {
    "metadatas": {
      "drops": {
        "edit": {
          "mainField": "label"
        },
        "list": {}
      }
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 1
    },
    "grade": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::grade.grade"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "drops": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::boss-drop.boss-drop",
      "mappedBy": "item"
    }
  }
}
