{
  "kind": "collectionType",
  "collectionName": "weapon_types",
  "info": {
    "singularName": "weapon-type",
    "pluralName": "weapon-types",
    "displayName": "Weapon type",
    "description": "A kind of weapon a raid boss resists or is vulnerable to. Six records against 120 usages: a record rather than an enumeration on each boss so the label is stored once, can be translated once, and shows up in the admin as a named chip instead of a collapsed accordion holding a select."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "config": {
    "settings": {
      "bulkable": true,
      "filterable": true,
      "searchable": true,
      "pageSize": 10,
      "mainField": "label",
      "defaultSortBy": "label",
      "defaultSortOrder": "ASC"
    }
  },
  "attributes": {
    "code": {
      "type": "uid",
      "required": true
    },
    "label": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "resistedBy": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::raid-boss.raid-boss",
      "mappedBy": "resistances"
    },
    "vulnerableBy": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::raid-boss.raid-boss",
      "mappedBy": "vulnerabilities"
    }
  }
}
