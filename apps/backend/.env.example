# Database client Strapi connects with. This project runs on PostgreSQL: the
# invite-code stage needs a real transaction to settle two simultaneous
# redemptions of a single-use code, and SQLite serialises writers instead.
# The `pg` driver is a dependency, so nothing extra is needed to select it.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rb_timer
DATABASE_USERNAME=rb_timer
DATABASE_PASSWORD=

# SQLite is still wired up in config/database.ts and remains usable for a
# throwaway instance, but the suite and the app both expect postgres.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

HOST=0.0.0.0
PORT=1337
# Public URL of this Strapi instance (used for password resets, OAuth
# callbacks, generated asset URLs). Defaults to http://localhost:1337.
PUBLIC_URL=
# Session/cookie signing keys — comma-separated, generate real random values
# for any non-local environment.
APP_KEYS=
ADMIN_JWT_SECRET=
JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
# Comma-separated list of origins allowed to call the REST API / connect the
# socket.io server, e.g. "https://example.com,https://www.example.com".
# Defaults to http://localhost:3000.
CORS_ORIGINS=

# One-off, read on the first boot after the community rework: names the
# community that pre-existing privileged users are moved into, so the new
# membership gate does not lock them out. Ignored afterwards (a flag in the
# core store records that the assignment ran) and ignored entirely on a fresh
# install, where there is nobody to migrate.
# Defaults to "Default Community" on server "Black".
# SEED_COMMUNITY_NAME=
# SEED_COMMUNITY_SERVER=Gamma|Black|White|Carmine|MasterWork
