# Database client Strapi connects with. Defaults to `sqlite` (file at
# `DATABASE_FILENAME`, default `.tmp/data.db`) if unset — nothing below is
# required for local development.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
#
# To use PostgreSQL instead, set DATABASE_CLIENT=postgres and the connection
# vars below. Requires adding the `pg` driver as a dependency first — selecting
# postgres without it fails at boot with a "cannot find module 'pg'" error.
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

HOST=0.0.0.0
PORT=1337
# Public URL of this Strapi instance (used for password resets, OAuth
# callbacks, generated asset URLs). Defaults to http://localhost:1337.
PUBLIC_URL=
# Session/cookie signing keys — comma-separated, generate real random values
# for any non-local environment.
APP_KEYS=
ADMIN_JWT_SECRET=
JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
# Comma-separated list of origins allowed to call the REST API / connect the
# socket.io server, e.g. "https://example.com,https://www.example.com".
# Defaults to http://localhost:3000.
CORS_ORIGINS=
