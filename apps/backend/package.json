{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "description": "A Strapi application",
  "scripts": {
    "dev": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "e2e:fixture": "node scripts/e2e-fixture.js",
    "e2e:invite-cleanup": "node scripts/e2e-invite-cleanup.js",
    "test": "vitest run && vitest run --config vitest.postgres.config.mts",
    "test:postgres": "vitest run --config vitest.postgres.config.mts",
    "test:watch": "vitest",
    "clean": "rm -rf dist dist-test",
    "check-types": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --error-on-warnings .",
    "format:fix": "biome format --write .",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "seed:catalog": "node scripts/seed-catalog.js",
    "prune:catalog": "node scripts/prune-catalog.js",
    "prune:catalog:delete": "node scripts/prune-catalog.js --delete",
    "export:catalog-grades": "node scripts/export-catalog-grades.js",
    "refresh:drops": "node scripts/catalogue/refresh-drops.js",
    "refresh:drops:write": "node scripts/catalogue/refresh-drops.js --write",
    "refresh:profile": "node scripts/catalogue/refresh-profile.js",
    "refresh:profile:write": "node scripts/catalogue/refresh-profile.js --write",
    "refresh:skills": "node scripts/catalogue/refresh-skills.js",
    "refresh:skills:write": "node scripts/catalogue/refresh-skills.js --write",
    "refresh:map": "node scripts/catalogue/refresh-map.js",
    "refresh:map:write": "node scripts/catalogue/refresh-map.js --write",
    "refresh:gamma": "node scripts/catalogue/refresh-gamma.js",
    "refresh:gamma:write": "node scripts/catalogue/refresh-gamma.js --write"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@rb-timer/typescript-config": "workspace:*",
    "@strapi/typescript-utils": "catalog:",
    "@types/node": "catalog:",
    "socket.io-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "catalog:",
    "@strapi/strapi": "catalog:",
    "@strapi/utils": "catalog:",
    "better-sqlite3": "^13.0.3",
    "pg": "8.23.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "sharp": "catalog:",
    "socket.io": "catalog:",
    "styled-components": "^6.0.0"
  },
  "author": {
    "name": "Oleg Tsyro"
  },
  "strapi": {
    "uuid": "7ab7659f-8f00-44d7-9fc3-3d2b7b1c1b8e"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "license": "MIT"
}
