# Used by `pnpm run dev`. Loaded by Next.js; the `NEXT_PUBLIC_` prefix is what
# puts a value into the browser bundle, which these need — the browser calls
# the API and opens the socket itself.
#
# They used to be whitelisted through the `env` key in next.config.js, which
# the framework marks as legacy and which inlines regardless of prefix.

# Example for reaching a backend on another machine on the LAN instead of
# localhost:
# NEXT_PUBLIC_API_URL=http://192.168.0.8:1337/api
# NEXT_PUBLIC_SOCKET_URL=http://192.168.0.8:1337
# NEXT_PUBLIC_IMAGE_URL=http://192.168.0.8:1337
# NEXT_PUBLIC_IMAGE_DOMAIN=192.168.0.8

NEXT_PUBLIC_API_URL=http://localhost:1337/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:1337
NEXT_PUBLIC_IMAGE_URL=http://localhost:1337
NEXT_PUBLIC_IMAGE_DOMAIN=localhost
