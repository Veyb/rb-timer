# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/e2e/.auth
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
# Auto-regenerated by `next dev`/`next build` (its own header says "should not
# be edited"). Its content toggles between `.next/dev/types/*` and
# `.next/types/*` paths depending on which command ran last - a known,
# currently-open Next.js 16 bug (vercel/next.js#86001, #85738), not something
# fixable from this project. Untracked to stop the resulting churn showing up
# as pending changes; both `next dev` and `next build` recreate it if missing.
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
