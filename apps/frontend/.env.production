# Used by `pnpm run build` / `pnpm run start`. Loaded by Next.js; the
# `NEXT_PUBLIC_` prefix puts them into the browser bundle, baked into the
# build rather than read at request time, so changing them requires a rebuild.
#
# The values below are safe placeholders (point at localhost) so a plain
# `pnpm run build` still produces a working build. There is no fixed
# production domain right now — for a real deploy, override these without
# editing this file, either by exporting real env vars before the build:
#
#   NEXT_PUBLIC_API_URL=https://<domain>/api NEXT_PUBLIC_SOCKET_URL=https://<domain> \
#   NEXT_PUBLIC_IMAGE_URL=https://<domain> NEXT_PUBLIC_IMAGE_DOMAIN=<domain> pnpm run build
#
# or by adding a git-ignored `.env.production.local` (Next.js loads it
# automatically and it takes precedence over this file).

NEXT_PUBLIC_API_URL=http://localhost:1337/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:1337
NEXT_PUBLIC_IMAGE_URL=http://localhost:1337
NEXT_PUBLIC_IMAGE_DOMAIN=localhost
