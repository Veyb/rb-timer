# Used by `pnpm run build` / `pnpm run start`. Loaded by Next.js, then
# whitelisted into the client+server bundle via the `env` key in
# next.config.js — these values are baked into the build, not read at
# request time, so changing them requires a rebuild.
#
# The values below are safe placeholders (point at localhost) so a plain
# `pnpm run build` still produces a working build. There is no fixed
# production domain right now — for a real deploy, override these without
# editing this file, either by exporting real env vars before the build:
#
#   API_URL=https://<domain>/api SOCKET_URL=https://<domain> \
#   IMAGE_URL=https://<domain> IMAGE_DOMAIN=<domain> pnpm run build
#
# or by adding a git-ignored `.env.production.local` (Next.js loads it
# automatically and it takes precedence over this file).

API_URL=http://localhost:1337/api
SOCKET_URL=http://localhost:1337
IMAGE_URL=http://localhost:1337
IMAGE_DOMAIN=localhost
