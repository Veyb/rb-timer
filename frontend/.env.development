# Used by `pnpm run dev`. Loaded by Next.js, then whitelisted into the
# client+server bundle via the `env` key in next.config.js.

# Example for reaching a backend on another machine on the LAN instead of
# localhost:
# API_URL=http://192.168.0.8:1337/api
# SOCKET_URL=http://192.168.0.8:1337
# IMAGE_URL=http://192.168.0.8:1337
# IMAGE_DOMAIN=192.168.0.8

API_URL=http://localhost:1337/api
SOCKET_URL=http://localhost:1337
IMAGE_URL=http://localhost:1337
IMAGE_DOMAIN=localhost
